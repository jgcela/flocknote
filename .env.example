# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fold?schema=public"

# Auth.js / NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used in emailed links (invitations, password resets).
# Defaults to NEXTAUTH_URL. Never derived from the request's Host header.
# APP_URL="https://app.example.org"
