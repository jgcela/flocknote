# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fold?schema=public"

# Auth.js / NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used in emailed links (invitations, password resets).
# Defaults to NEXTAUTH_URL. Never derived from the request's Host header.
# On Vercel the production domain is used automatically when this is unset.
# APP_URL="https://app.example.org"

# ── Messaging ──────────────────────────────────────────────
# Without these, emails and texts are printed to the server log (console mode).
# EMAIL_PROVIDER="resend"            # resend | console (default: resend if RESEND_API_KEY is set)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Fold <no-reply@your-domain.org>"   # domain must be verified in Resend
# EMAIL_REPLY_TO="office@your-church.org"         # optional; each church's own email is used when set
# RESEND_WEBHOOK_SECRET="whsec_..."  # Resend → Webhooks → /api/webhooks/resend

# SMS_PROVIDER="twilio"              # twilio | console (default: twilio if TWILIO_ACCOUNT_SID is set)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."            # also verifies /api/webhooks/twilio
# TWILIO_FROM_NUMBER="+15551234567"  # or:
# TWILIO_MESSAGING_SERVICE_SID="MG..."

# Protects /api/cron/dispatch (scheduled + interrupted sends). Call it every few minutes.
# CRON_SECRET="long-random-string"
